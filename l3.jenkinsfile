pipeline {
    agent any

    triggers {
        pollSCM('* * * * *')
    }

    options {
        disableConcurrentBuilds()
        timestamps()
    }

    environment {
        TF_IN_AUTOMATION = "true"
    }

    stages {

        stage('Checkout') {
            when {
                branch 'master'
            }
            steps {
                checkout scm
            }
        }

        stage('Terraform Init') {
            when {
                branch 'master'
            }
            steps {
                sh '''
                  terraform init -lockfile=readonly
                '''
            }
        }

        stage('Terraform Plan') {
            when {
                branch 'master'
            }
            steps {
                sh '''
                  terraform plan -out=tfplan
                '''
            }
        }

        stage('Terraform Apply') {
            when {
                branch 'master'
            }
            steps {
                sh '''
                  terraform apply -auto-approve tfplan
                '''
            }
        }
    }

    post {
        success {
            echo "Terraform deployment to master environment completed successfully."
        }
        failure {
            echo "Terraform deployment failed. Check logs."
        }
    }
}
